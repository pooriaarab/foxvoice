{
  "manifest_version": 3,
  "name": "foxvoice \u2014 push to talk for your browser",
  "version": "0.1.2",
  "description": "Speak a goal to your Firefox agent and hear the result, with speech that stays on your device.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "foxvoice@pooriaarab",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "foxvoice: push to talk",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "sidebar_action": {
    "default_title": "foxvoice",
    "default_panel": "panel.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  }
}
